{
  "name": "AI Startup Idea Validator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash -lc 'nohup ./run_project.sh > /tmp/startup-validator.log 2>&1 &'",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit app",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
