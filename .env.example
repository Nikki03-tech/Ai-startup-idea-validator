GEMINI_MODEL=gemini-3.5-flash-lite
STARTUP_VALIDATOR_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated pool. Takes precedence over GEMINI_API_KEY.
# GEMINI_API_KEYS=key1,key2,key3
SEARCH_ENGINE=duckduckgo
MAX_RESULTS=5
LOG_LEVEL=INFO
DEEPEVAL_GEMINI_API_KEY=your_deepeval_gemini_api_key_here

# PostgreSQL connection string used by database/db.py. Optional -
# only needed if something in the project persists data (e.g. chat
# history). Without it, database/db.py's engine/SessionLocal stay
# None and get_db()/init_db() raise a clear error only if used.
DATABASE_URL=postgresql://user:password@localhost:5432/startup_validator
